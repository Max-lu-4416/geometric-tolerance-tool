<Window x:Class="Tolerance.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="几何公差查询工具" Width="1220" Height="780" MinWidth="1100" MinHeight="660" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource Ink}" Background="{DynamicResource CanvasBackground}" UseLayoutRounding="True">
  <Viewbox x:Name="LayoutHost" Stretch="Uniform" StretchDirection="DownOnly" Margin="0">
    <Grid x:Name="DesignSurface" Width="1180" Height="700" Background="{DynamicResource CanvasBackground}">
      <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="几何公差查询" FontSize="24" FontWeight="Medium" /><TextBlock Text="选择类型与等级，输入参数；点击等级可查看选用说明" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="410" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
          <StackPanel>
            <Grid Margin="0,0,0,12"><TextBlock Text="公差类型" FontSize="16" FontWeight="Medium" /><TextBlock Text="{Binding SelectedType.Name}" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontSize="12" /></Grid>
            <ItemsControl x:Name="TypeGroups" ItemsSource="{Binding TypeGroups}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,8,0,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4" /></Border>
                  <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="ToleranceType" Checked="TypeChoice_Checked" Tag="{Binding Type}" IsEnabled="{Binding IsAvailable}"
                                   AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Help}" ToolTipService.ShowOnDisabled="True" Height="56" Padding="2,4" Margin="2,0">
                        <RadioButton.IsChecked><MultiBinding Converter="{StaticResource SelectionEquals}" Mode="OneWay"><Binding Path="DataContext.SelectedType" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="Type" /></MultiBinding></RadioButton.IsChecked>
                        <StackPanel>
                          <Viewbox Width="32" Height="24" Margin="0,0,0,4"><Canvas Width="26" Height="25"><Path Data="{Binding Geometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" StrokeLineJoin="Round" /><Path Data="{Binding ArrowHeads}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></Canvas></Viewbox>
                          <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" TextWrapping="NoWrap" />
                        </StackPanel>
                      </RadioButton>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="位置度按数系选取，本版不提供等级查值" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
              <Grid Margin="0,0,0,8"><TextBlock Text="公差等级" FontSize="16" FontWeight="Medium" /><TextBlock Text="{Binding SelectedGradeCode, StringFormat={}{0} 级}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" /></Grid>
              <ItemsControl x:Name="GradeChoices" ItemsSource="{Binding AllGradeChoices}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="ToleranceGrade" Tag="{Binding Code}" Checked="GradeChoice_Checked" Click="GradeChoice_Click" IsEnabled="{Binding IsAvailable}" Height="36" Margin="0,0,4,4" Background="{DynamicResource CanvasBackground}" BorderBrush="{DynamicResource Hairline}" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Code, StringFormat={}公差等级 {0}}">
                    <RadioButton.IsChecked><MultiBinding Converter="{StaticResource SelectionEquals}" Mode="OneWay"><Binding Path="DataContext.SelectedGradeCode" RelativeSource="{RelativeSource AncestorType=Window}" /><Binding Path="Code" /></MultiBinding></RadioButton.IsChecked>
                    <TextBlock Text="{Binding Code}" FontFamily="Segoe UI" FontSize="16" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                  </RadioButton>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding GradeHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
              <Grid Margin="0,0,0,4"><TextBlock Text="主参数 / mm" FontSize="14" FontWeight="Medium" /><TextBlock Text="{Binding ParameterLabel}" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Right" /></Grid>
              <TextBox x:Name="ParameterBox" AutomationProperties.AutomationId="ParameterBox" AutomationProperties.Name="主参数 mm" IsEnabled="{Binding LengthRequired}" Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}" Height="36" MinHeight="36" Padding="8,4" />
              <TextBlock Text="{Binding AllowedRange}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
              <TextBlock Text="{Binding ParameterHint}" Foreground="{DynamicResource Secondary}" FontSize="12" LineHeight="18" Margin="0,4,0,0" />
              <StackPanel x:Name="SizeTolerancePanel" Visibility="{Binding SizeToleranceRequired, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                <TextBlock Text="{Binding SizeToleranceLabel}" FontSize="12" Margin="0,0,0,4" /><TextBox x:Name="SizeToleranceBox" AutomationProperties.Name="尺寸公差 mm" ToolTip="输入上极限尺寸与下极限尺寸之差，例如 ±0.1 mm 应填 0.2" Text="{Binding SizeToleranceText, UpdateSourceTrigger=PropertyChanged}" Height="36" MinHeight="36" Padding="8,4" />
              </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><TextBlock Text="公差值" FontSize="16" FontWeight="Medium" /><TextBlock Text="{Binding ResultState}" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right" /></Grid></Border>
              <StackPanel Grid.Row="1" Margin="0,4,0,0"><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="52" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ResultNumber" Text="{Binding Millimeters}" FontFamily="Segoe UI" FontSize="36" Foreground="{DynamicResource Accent}" Typography.NumeralAlignment="Tabular" /><TextBlock Text="mm" FontSize="16" Foreground="{DynamicResource Secondary}" VerticalAlignment="Bottom" Margin="8,0,0,8" /></StackPanel></Viewbox><TextBlock Text="{Binding Micrometers}" FontSize="15" Foreground="{DynamicResource Secondary}" /></StackPanel>
              <StackPanel Grid.Row="2" Margin="0,4,0,0"><TextBlock Text="{Binding ResultDescription}" FontSize="12" /><TextBlock Text="{Binding Interval}" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,4,0,0" /><TextBlock x:Name="RuleText" Text="{Binding RuleText}" FontSize="12" Foreground="{DynamicResource Secondary}" LineHeight="17" Margin="0,4,0,0" /></StackPanel>
              <TextBlock Grid.Row="3" x:Name="ErrorText" Text="{Binding Error}" Foreground="{DynamicResource Error}" FontSize="12" LineHeight="17" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <UniformGrid Grid.Row="5" Columns="3" Margin="0,8,0,0"><Button x:Name="CopyMm" Content="复制 mm" Click="CopyMm_Click" IsEnabled="{Binding HasResult}" Background="{DynamicResource PrimarySurface}" BorderBrush="{DynamicResource PrimarySurface}" Foreground="{DynamicResource PrimaryInk}" Padding="4,10" Margin="0,0,4,0" /><Button x:Name="CopyUm" Content="复制 μm" Click="CopyUm_Click" IsEnabled="{Binding HasResult}" Padding="4,10" Margin="0,0,4,0" /><Button x:Name="CopyFull" Content="复制完整结果" Click="CopyFull_Click" IsEnabled="{Binding HasResult}" Padding="4,10" /></UniformGrid>
              <TextBlock Grid.Row="6" x:Name="CopyStatus" Text="数值复制不含单位" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Column="4">
          <Grid.RowDefinitions><RowDefinition Height="270" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="{Binding DiagramCaption}" FontSize="16" FontWeight="Medium" /><Image x:Name="ParameterDiagram" Grid.Row="1" Source="{Binding DiagramPath}" Stretch="Uniform" Margin="0,12,0,0" /></Grid>
          </Border>
          <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel><TextBlock Text="{Binding AdviceTitle}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource Secondary}" /><TextBlock x:Name="AdviceApplication" Text="{Binding AdviceApplication}" FontSize="14" LineHeight="23" Margin="0,12,0,0" /><TextBlock Text="{Binding AdviceExamples}" FontSize="12" LineHeight="22" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0" /><TextBlock Text="{Binding AdviceNote}" FontSize="12" LineHeight="20" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" /></StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Viewbox>
</Window>
